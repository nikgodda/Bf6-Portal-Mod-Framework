{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "node",

        "rootDir": "src",
        "outDir": "dist",

        "allowJs": true,
        "declaration": true,
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true
    },

    "include": ["src/**/*.ts"],
    "exclude": ["src/scripts"]
}
